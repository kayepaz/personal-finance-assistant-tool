{
  "version": "0.4.0",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env server/main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env server/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net=127.0.0.1",
    "check": "deno check server/main.ts && deno check --config client/deno.json client/app.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 110,
    "exclude": [
      "./data/",
      "./e2e/node_modules/",
      "./e2e/test-results/",
      "./e2e/playwright-report/"
    ]
  },
  "lint": {
    "exclude": [
      "./data/",
      "./e2e/node_modules/",
      "./e2e/test-results/",
      "./e2e/playwright-report/"
    ]
  },
  "exclude": [
    "./data/",
    "./e2e/node_modules/",
    "./e2e/test-results/",
    "./e2e/playwright-report/"
  ]
}
